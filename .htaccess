Options -Indexes -MultiViews
DirectoryIndex index.php
RewriteEngine On
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
# Only these public entrypoints/assets are reachable. Never serve source/config/database files.
RewriteRule (^|/)\. - [F,L]
RewriteRule ^webassets/[A-Za-z0-9_.-]+\.(js|css)$ - [L]
RewriteRule ^images/([A-Za-z0-9_.-]+\.(webp|jpg|jpeg|png))$ public/images/$1 [L]
RewriteRule ^fonts/([A-Za-z0-9_.-]+\.(css|ttf|woff2?))$ public/fonts/$1 [L]
RewriteRule ^favicon\.svg$ public/favicon.svg [L]
RewriteRule ^public/(images/[A-Za-z0-9_.-]+\.(webp|jpg|jpeg|png)|fonts/[A-Za-z0-9_.-]+\.(css|ttf|woff2?)|favicon\.svg)$ - [L]
RewriteRule ^(index|setup|login|logout)\.php$ - [L]
RewriteRule ^(api(?:/.*)?|admin/?)$ index.php [QSA,L]
RewriteRule ^$ index.php [L]
RewriteRule ^ - [F,L]
<IfModule mod_headers.c>
 Header always set X-Content-Type-Options "nosniff"
 Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
